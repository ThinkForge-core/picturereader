# Matches a directory *and* a symlink of this name: the usual `node_modules/`
# only covers the directory, so a checkout whose node_modules is a link to
# somewhere else would get committed, target path and all.
node_modules
tests/fixtures-out/
.paddlex-cache/
.codex_tmp/
*.log
*.tgz
.eac-copy-stamp.json
docs/
.DS_Store
__pycache__/
*.pyc
# npm cache used when the default ~/.npm is not writable
.npmcache-local/

# local install sandbox used by acceptance runs
.pr-test/

# throwaway environments created by ad-hoc install runs
.pr-*/
